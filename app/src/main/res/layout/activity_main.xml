<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 分类 Tab -->
        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="真人剧"
                android:textSize="15sp"
                android:textColor="@color/tab_text"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/tab_comic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="漫剧"
                android:textSize="15sp"
                android:textColor="@color/tab_text"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/tab_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="AI剧"
                android:textSize="15sp"
                android:textColor="@color/tab_text"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_search"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_history"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_history"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_favorite"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_favorite"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_rank"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_rank"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_log"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_log"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_update"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nav_update"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="@drawable/button_bg"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
